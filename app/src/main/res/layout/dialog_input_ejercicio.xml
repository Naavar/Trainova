<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del Ejercicio"
        style="@style/TextAppearance.MaterialComponents.Caption"/>
    <EditText
        android:id="@+id/etNombreEjercicioInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: Press de Banca"
        android:inputType="textCapWords"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Series"
        style="@style/TextAppearance.MaterialComponents.Caption"/>
    <EditText
        android:id="@+id/etSeriesEjercicioInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: 4"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeticiones"
        style="@style/TextAppearance.MaterialComponents.Caption"/>
    <EditText
        android:id="@+id/etRepeticionesEjercicioInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: 10-12, Al fallo"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descanso"
        style="@style/TextAppearance.MaterialComponents.Caption"/>
    <EditText
        android:id="@+id/etDescansoEjercicioInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: 60s, 1-2 min"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notas (opcional)"
        style="@style/TextAppearance.MaterialComponents.Caption"/>
    <EditText
        android:id="@+id/etNotasEjercicioInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: Controlar fase excéntrica"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:gravity="top"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnCancelarEjercicioInput"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Cancelar"/>
        <Button
            android:id="@+id/btnGuardarEjercicioInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Guardar Ejercicio"/>
    </LinearLayout>
</LinearLayout>