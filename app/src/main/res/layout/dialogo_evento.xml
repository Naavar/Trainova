<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorFondoPrimario"
    tools:context=".activity.HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/colorFondoPrimario"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/editTextEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese actividad"
            android:textColor="#FAFAFA"
            android:textColorHint="@color/white" />

        <Button
            android:id="@+id/botonGuardarEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/colorPrimario"
            android:text="GUARDAR"
            android:textColorLink="@color/colorSecundario" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>